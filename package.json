{
  "name": "gamepilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "mcp:gamepad": "node --import tsx src/mcp/gamepad-mcp-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/config.test.ts tests/model-connection.test.ts tests/session.test.ts tests/capture.test.ts tests/mcp-gamepad.test.ts tests/simulated-controller.test.ts tests/mcp-stdio.test.ts tests/game-loop.test.ts tests/gamepad-loop.test.ts",
    "test:runtime": "node --import ./scripts/pi-source.mjs --import tsx --test tests/runtime.test.ts tests/intent.test.ts",
    "test:ui": "node tests/electron-smoke.mjs",
    "test:dev": "node tests/dev-smoke.mjs",
    "test:capture": "node tests/capture-smoke.mjs",
    "test:capture-requests": "node tests/capture-request-smoke.mjs",
    "test:mcp": "node --import tsx --test tests/mcp-gamepad.test.ts tests/mcp-stdio.test.ts",
    "test:model-api": "node --import tsx --test tests/model-connection.test.ts",
    "test:model-api-ui": "node tests/model-api-ui-smoke.mjs",
    "test:game-loop": "node --import tsx tests/game-loop-smoke.mjs",
    "test:conversation": "node tests/conversation-smoke.mjs",
    "setup:gamepad": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-gamepad.ps1",
    "test:virtual-gamepad": "node --import tsx tests/virtual-gamepad-smoke.mjs",
    "test:gamepad-loop": "node --import tsx tests/game-loop-smoke.mjs --gamepad"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.1.3",
    "@types/node": "22.19.19",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.1.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite": "6.4.4"
  }
}
